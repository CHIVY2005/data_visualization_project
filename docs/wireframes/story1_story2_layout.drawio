        </mxCell>
        <mxCell id="403" value="What → Why → How / Story 1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=15;fontColor=#0F172A;fontStyle=1;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="4">
          <mxGeometry x="238" y="994" width="900" height="20" as="geometry" />
        </mxCell>
        <mxCell id="404" value="Dữ liệu: tải / OT / giờ / mùa  →  tác vụ: chu kỳ, cơ cấu, lag  →  encoding: position, length, heatmap" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#475569;fontStyle=0;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="4">
          <mxGeometry x="238" y="1019" width="900" height="16" as="geometry" />
        </mxCell>
        <mxCell id="405" value="• Composition: tải âm / mẫu số ≤0 → null + chú thích chất lượng; không clip về 0.&#10;• “Lag tối ưu” chỉ là lag có |r| lớn nhất theo phạm vi/phương pháp; không phải khuyến nghị điều khiển.&#10;• Tỷ lệ vô công là ratio từ nhãn nguồn useful/unuseful; không mặc nhiên P/Q đã hiệu chuẩn." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=12;fontColor=#475569;fontStyle=0;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="4">
          <mxGeometry x="242" y="1053" width="892" height="51" as="geometry" />
        </mxCell>
        <mxCell id="406" value="" style="rounded=1;arcSize=6;fillColor=#F8FAFC;strokeColor=#E2E8F0;shadow=0;" vertex="1" parent="4">
          <mxGeometry x="222" y="1156" width="932" height="215" as="geometry" />
        </mxCell>
        <mxCell id="407" value="NGUYÊN TẮC BỐ CỤC / TƯƠNG TÁC" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=14;fontColor=#1E3A8A;fontStyle=1;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="4">
          <mxGeometry x="242" y="1175" width="892" height="19" as="geometry" />
        </mxCell>
        <mxCell id="408" value="Gestalt proximity: 4 KPI liên quan cùng hàng; alignment: lưới và trục thẳng hàng.&#10;Similarity: useful = Teal, bối cảnh = Slate; enclosure: dải phân vị, không trang trí 3D/shadow.&#10;Tufte: chỉ lưới chính nhẹ; direct labels khi đủ chỗ; tiêu đề insight phải sinh từ dữ liệu đang lọc.&#10;Accessibility: chữ tối trên nền sáng; thêm nhãn/dash, không truyền trạng thái chỉ bằng màu.&#10;Mỗi ô là vùng xem mục tiêu; runtime có thể dùng view selector/lazy render để bảo vệ SLA." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=13;fontColor=#475569;fontStyle=0;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="4">
          <mxGeometry x="242" y="1211" width="892" height="90" as="geometry" />
        </mxCell>
        <mxCell id="409" value="DỮ LIỆU LỊCH SỬ · Ngưỡng 85/95°C là quy ước dự án · Không phải hệ thống an toàn chứng nhận" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#475569;fontStyle=0;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="4">
          <mxGeometry x="222" y="1474" width="932" height="16" as="geometry" />
        </mxCell>
        <mxCell id="410" value="Tất cả đường/điểm trong bản vẽ là minh họa bố cục, không phải kết quả ETT. Không suy nhân quả." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#475569;fontStyle=0;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="4">
