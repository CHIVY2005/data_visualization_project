        <mxCell id="401" value="6 tải × 13 lags  |  0h → 12h&#10;Diverging palette: không mã cảnh báo" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#475569;fontStyle=0;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="4">
